# 复制为 .env；填入服务商提供的密钥、完整 /v1 地址和模型名。
# 不要把真实密钥提交到 GitHub。
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_CHAT_MODEL=gpt-4o-mini

# 向量服务使用阿里云百炼；聊天仍可以使用你原来的服务商。
# 填写与下面地址地域匹配的百炼密钥。聊天也是百炼时可共用。
# 如果聊天来自其他平台，不能把其密钥当作百炼密钥。
EMBEDDING_API_KEY=
# 以下是北京共享地址；也可填控制台对应业务空间的兼容接口地址。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=text-embedding-v4
# 百炼v4每个请求最多10条文本；不是文本切块的字符长度。
EMBEDDING_BATCH_SIZE=10

# cosine 相似度只是筛选信号，不是正确率；需要用自己的问题调试。
RETRIEVAL_THRESHOLD=0.55
RETRIEVAL_TOP_K=4
